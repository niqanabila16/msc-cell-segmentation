# ============================================================
# .env.example  —  APE MSC v3
# Salin ke .env lalu sesuaikan. Semua variabel opsional.
# ============================================================

# ── Direktori ─────────────────────────────────────────────────
OUTPUT_DIR=outputs
TEMP_DIR=temp

# ── Config YAML SAM2 (relatif terhadap package sam2) ──────────
# Untuk SAM2 Large   : sam2/sam2_hiera_l.yaml
# Untuk SAM2 Base+   : sam2/sam2_hiera_b+.yaml
# Untuk SAM2 Small   : sam2/sam2_hiera_s.yaml
# Untuk SAM2 Tiny    : sam2/sam2_hiera_t.yaml
SAM2_MODEL_CFG=sam2/sam2_hiera_l.yaml

# ── Override daftar model (JSON, opsional) ─────────────────────
# Jika kosong → auto-scan folder models/sam2/ dan models/unet/
#
# SAM2_VERSIONS=[{"label":"best_model.pth","path":"models/sam2/best_model.pth","cfg":"sam2/sam2_hiera_l.yaml"}]
# UNET_VERSIONS=[{"label":"unet_msc.pth","path":"models/unet/unet_msc.pth"}]

# ── Parameter SAM2AutomaticMaskGenerator ──────────────────────
SAM2_POINTS_PER_SIDE=32
SAM2_PRED_IOU_THRESH=0.88
SAM2_STABILITY_SCORE_THRESH=0.95

# ── Upload ─────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MIN_IMAGE_DIM=64

# ── Preprocessing ──────────────────────────────────────────────
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_GRID=8

# ── Visualisasi ────────────────────────────────────────────────
OVERLAY_ALPHA=0.55
